{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Сайт: отладка сервера",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run go",
      "serverReadyAction": { "pattern": "- Local:.+(https?://\\S+)", "uriFormat": "%s", "action": "openExternally" }
    },
    {
      "name": "Сайт: отладка в браузере",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000"
    }
  ]
}
