{$DOMAIN} {
	encode zstd gzip

	# SSE (/api/events) — без буферизации, иначе события будут приходить пачками
	@events path /api/events
	reverse_proxy @events app:3000 {
		flush_interval -1
	}

	# Caddy сам передаёт X-Forwarded-For — по нему в админке видно IP посетителя
	reverse_proxy app:3000

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}
