# Скопируйте в .env.production на сервере и заполните. Этот файл в git не попадает.
DOMAIN=techstore.example.ru
APP_URL=https://techstore.example.ru

# openssl rand -hex 24
POSTGRES_PASSWORD=
# пароль роли, под которой работает сайт (без права менять схему базы): openssl rand -hex 24
APP_DB_PASSWORD=
# openssl rand -base64 32
SESSION_SECRET=
# openssl rand -base64 48 — перец для паролей. После запуска НЕ менять: все пароли перестанут подходить
PASSWORD_PEPPER=
# openssl rand -hex 32
PAYMENT_WEBHOOK_SECRET=
# openssl rand -hex 32
CRON_SECRET=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=TechStore <noreply@example.ru>

# Вход через Google (README → «Вход через Google»). Пусто — кнопка покажет «не настроен»
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Поддержка: куда приходят обращения с сайта (на сайте не показывается)
SUPPORT_INBOX=
# Публичный адрес поддержки на своём домене, пересылка на SUPPORT_INBOX. Пусто — только форма
SUPPORT_EMAIL_PUBLIC=

# 1 — демо-магазин: тестовая оплата и плашка «Демо-магазин» на сайте.
# Пока не подключён настоящий платёжный шлюз, без этого оформить заказ нельзя.
DEMO_STORE=1
