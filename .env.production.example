# Скопируйте в .env.production на сервере и заполните. Этот файл в git не попадает.
DOMAIN=techstore.example.ru
APP_URL=https://techstore.example.ru

# openssl rand -hex 24
POSTGRES_PASSWORD=
# openssl rand -base64 32
SESSION_SECRET=
# openssl rand -hex 32
PAYMENT_WEBHOOK_SECRET=
# openssl rand -hex 16
CRON_SECRET=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=TechStore <noreply@example.ru>

# Вход через Google (README → «Вход через Google»). Пусто — кнопка покажет «не настроен»
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Поддержка: куда приходят обращения с сайта (на сайте не показывается)
SUPPORT_INBOX=
# Публичный адрес поддержки на своём домене, пересылка на SUPPORT_INBOX. Пусто — только форма
SUPPORT_EMAIL_PUBLIC=
