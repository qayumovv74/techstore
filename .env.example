DATABASE_URL=postgres://techstore:techstore@localhost:5432/techstore
REDIS_URL=redis://localhost:6379
# Секрет для подписи сессии: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Адрес сайта — для ссылок в письмах
APP_URL=http://localhost:3000

# Почта. Пусто — в разработке письма уходят в тестовый ящик Ethereal (ссылка в консоли).
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=ваш@gmail.com,
#        SMTP_PASS=пароль приложения (myaccount.google.com → Безопасность → Пароли приложений)
# Яндекс: SMTP_HOST=smtp.yandex.ru, SMTP_PORT=465, пароль приложения из id.yandex.ru
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Секрет подписи вебхуков платёжного шлюза: openssl rand -hex 32
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret-at-least-32-chars-long
# Секрет для /api/cron/release (снятие просроченных резервов по расписанию)
CRON_SECRET=change-me-cron-secret

# Вход через Google (README → «Вход через Google»). Пусто — кнопка покажет «не настроен»
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
