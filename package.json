{
  "name": "techstore",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "go": "npm run db:local && next dev",
    "db:local": "tsx scripts/local-db.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:up": "docker compose up -d",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx --env-file=.env scripts/seed.ts && npm run images:import",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "images:import": "tsx --env-file=.env scripts/import-images.ts",
    "staff": "node --env-file=.env scripts/staff.mjs",
    "test:e2e": "playwright test",
    "db:stop": "tsx scripts/local-db.ts stop",
    "check": "npm run lint && npm run typecheck"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@node-rs/argon2": "^2.2.2",
    "animejs": "^4.5.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.15",
    "lucide-react": "^1.70.0",
    "motion": "^14.10.1",
    "next": "16.4.4",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "three": "^0.187.0",
    "ua-parser-js": "^1.0.40",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.187.0",
    "@types/ua-parser-js": "^0.7.39",
    "drizzle-kit": "^0.31.11",
    "embedded-postgres": "17.11.0-beta.19",
    "eslint": "^10",
    "eslint-config-next": "16.4.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "allowScripts": {
    "@embedded-postgres/windows-x64@17.11.0-beta.19": true,
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
